SENTINEL_HUB_CLIENT_ID=your-client-id-here
SENTINEL_HUB_CLIENT_SECRET=your-client-secret-here

# Endpoint: "sentinel-hub" (default) or "cdse" (Copernicus Data Space - free)
# For CDSE: register at https://dataspace.copernicus.eu/ and create OAuth credentials
SENTINEL_HUB_ENDPOINT=sentinel-hub

# Fortune production integration — server/worker configuration only.
# Use encrypted deployment secrets; never put real values in browser builds.
FFL_DATABASE_URL=
FFL_POSTGRES_SCHEMA=agro
FFL_MANAGER_PERSON_ID=
FFL_TRACKWICK_ENABLED=false
FFL_TRACKWICK_CUSTOMER_ID=
FFL_TRACKWICK_API_KEY=
FFL_TRACKWICK_API_KEY_REFERENCE=env://FFL_TRACKWICK_API_KEY
FFL_TRACKWICK_TENANT_ID=fortune-paddy
FFL_TRACKWICK_REPORTING_TIMEZONE=Asia/Kolkata
FFL_TRACKWICK_DELTA_LOOKBACK_DAYS=2
FFL_PORTAL_BASE_DOMAIN=agroceo.com
FFL_PORTAL_SESSION_SECRET=replace-with-a-strong-server-only-secret
FFL_PORTAL_SESSION_MAX_AGE_SECONDS=43200
FFL_SUPABASE_URL=https://your-project.supabase.co
FFL_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
FFL_PORTAL_OTP_CHANNEL=sms
