# Copernicus Data Space Ecosystem (CDSE) is the recommended free tier.
# Register: https://dataspace.copernicus.eu/
# After registering, create an OAuth client:
#   Dashboard -> User settings -> OAuth clients -> Create
# The client_id will start with "sh-..." and the secret is shown once.
SENTINEL_HUB_ENDPOINT=cdse

SENTINEL_HUB_CLIENT_ID=your-client-id-here
SENTINEL_HUB_CLIENT_SECRET=your-client-secret-here

# If you have a paid Sentinel Hub subscription instead, set:
#   SENTINEL_HUB_ENDPOINT=sentinel-hub
# Credentials are NOT interchangeable between the two realms.
